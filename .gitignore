# Claude Code writes caches, sessions, daemon state and backups into ~/.claude.
# Only the portable setup below is versioned; new setup files need a `!` line.
/mac-config/mac-dotfiles/claude/.claude/*
!/mac-config/mac-dotfiles/claude/.claude/CLAUDE.md
!/mac-config/mac-dotfiles/claude/.claude/settings.json
!/mac-config/mac-dotfiles/claude/.claude/keybindings.json
!/mac-config/mac-dotfiles/claude/.claude/mcp.json
!/mac-config/mac-dotfiles/claude/.claude/statusline.sh
!/mac-config/mac-dotfiles/claude/.claude/commands/
!/mac-config/mac-dotfiles/claude/.claude/hooks/
!/mac-config/mac-dotfiles/claude/.claude/skills/
/mac-config/mac-dotfiles/claude/.claude/skills/.trash/
/mac-config/mac-dotfiles/claude/.claude/skills/synced/
/mac-config/mac-dotfiles/claude/.claude/**/.cc-writes/

# Local repos live here via the stowed workspace; keep only shared agent files tracked.
/common-config/common-dotfiles/workspace-agent/workspace/*
!/common-config/common-dotfiles/workspace-agent/workspace/AGENTS.md
!/common-config/common-dotfiles/workspace-agent/workspace/CLAUDE.md

# Macarchy owns installed themes, generated output and machine-local state.
# Only these deliberate portable inputs may be versioned in its Stow package.
/mac-config/mac-dotfiles/macarchy/.config/macarchy/*
!/mac-config/mac-dotfiles/macarchy/.config/macarchy/profile.toml
!/mac-config/mac-dotfiles/macarchy/.config/macarchy/overrides/

# Generated consumer palettes are not dotfile sources (even when symlinks).
**/macarchy-current.json
**/macarchy-current.toml
**/macarchy-current.tmTheme
**/macarchy-current.theme
/mac-config/mac-dotfiles/spicetify/.config/spicetify/Themes/text/color.ini

# Native Neovim behavior is portable; these four theme links are machine-local.
/mac-config/mac-dotfiles/nvim/.config/nvim/colors/macarchy-imported.lua
/mac-config/mac-dotfiles/nvim/.config/nvim/lua/macarchy/current.lua
/mac-config/mac-dotfiles/nvim/.config/nvim/lua/config/macarchy-theme.lua
/mac-config/mac-dotfiles/nvim/.config/nvim/lua/plugins/colorscheme.lua
