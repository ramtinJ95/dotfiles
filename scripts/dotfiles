#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

COMMON_DIR="$REPO_ROOT/common-config/common-dotfiles"
MAC_DIR="$REPO_ROOT/mac-config/mac-dotfiles"
ARCH_DIR="$REPO_ROOT/arch-config/arch-dotfiles"
PACKAGE_DIR="$REPO_ROOT/packages"

failures=0

info() {
    printf '==> %s\n' "$1"
}

pass() {
    printf 'OK: %s\n' "$1"
}

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    failures=$((failures + 1))
}

warn() {
    printf 'WARN: %s\n' "$1" >&2
}

usage() {
    cat <<'EOF'
Usage: scripts/dotfiles <command> [profile]

Commands:
  doctor              Validate package lists, Stow dry-runs, symlinks, shell, and JSON
  stow mac            Link Macarchy inputs/personal tools; seed absent native configs
  stow arch           Stow common and Arch user packages into $HOME
  stow arch-system    Stow Arch system packages into /
  restow mac          Restow common and macOS user packages into $HOME
  restow arch         Restow common and Arch user packages into $HOME
  restow arch-system  Restow Arch system packages into /
  install-herdr arch   Install Herdr from the AUR, or the official installer when no AUR helper exists
EOF
}

package_root() {
    case "$1" in
        common) printf '%s\n' "$COMMON_DIR" ;;
        mac|mac-legacy) printf '%s\n' "$MAC_DIR" ;;
        arch|arch-system) printf '%s\n' "$ARCH_DIR" ;;
        *) return 1 ;;
    esac
}

package_list() {
    printf '%s/%s.txt\n' "$PACKAGE_DIR" "$1"
}

package_names() {
    while IFS= read -r package || [[ -n "$package" ]]; do
        [[ -z "$package" || "$package" == \#* ]] && continue
        printf '%s\n' "$package"
    done < "$(package_list "$1")"
}

check_package_list() {
    local list_name="$1"
    local root
    root="$(package_root "$list_name")"
    local list_file
    list_file="$(package_list "$list_name")"

    if [[ ! -d "$root" ]]; then
        fail "$list_name root missing: $root"
        return
    fi

    if [[ ! -f "$list_file" ]]; then
        fail "$list_name package list missing: $list_file"
        return
    fi

    local package
    while IFS= read -r package; do
        [[ -d "$root/$package" ]] || fail "$list_name lists missing package: $package"
    done < <(package_names "$list_name")

    local listed
    local present
    listed="$(mktemp)"
    present="$(mktemp)"

    package_names "$list_name" | sort > "$listed"
    if [[ "$list_name" == "mac" ]]; then
        # Retain old provider sources without installing them over Macarchy.
        while IFS= read -r package; do
            [[ -d "$root/$package" ]] || fail "mac-legacy lists missing package: $package"
            if grep -Fxq "$package" "$listed"; then
                fail "mac package is both active and legacy: $package"
            fi
        done < <(package_names mac-legacy)
        package_names mac-legacy >> "$listed"
        sort -u "$listed" -o "$listed"
    fi
    if [[ "$list_name" == "arch" ]]; then
        find "$root" -maxdepth 1 -mindepth 1 -type d ! -name tlp -exec basename {} \; | sort > "$present"
    elif [[ "$list_name" == "arch-system" ]]; then
        printf 'tlp\n' > "$present"
    else
        find "$root" -maxdepth 1 -mindepth 1 -type d -exec basename {} \; | sort > "$present"
    fi

    local unlisted
    unlisted="$(comm -23 "$present" "$listed")"
    if [[ -n "$unlisted" ]]; then
        fail "$list_name has unlisted package directories: $(printf '%s' "$unlisted" | paste -sd ', ' -)"
    fi

    rm -f "$listed" "$present"
}

run_stow_dry_run() {
    run_stow_action simulate "$1" "$2" "${3:-}"
}

run_stow_action() {
    local action="$1"
    local list_name="$2"
    local target="$3"
    local profile="${4:-}"
    local root
    root="$(package_root "$list_name")"

    if ! command -v stow >/dev/null 2>&1; then
        fail "stow command is not available"
        return
    fi

    local packages=()
    local package
    while IFS= read -r package; do
        packages+=("$package")
    done < <(package_names "$list_name")
    if [[ "${#packages[@]}" -eq 0 ]]; then
        fail "$list_name package list is empty"
        return
    fi

    local args=(-d "$root" -t "$target")
    case "$action" in
        stow) ;;
        restow) args+=(-R) ;;
        simulate) args+=(-n) ;;
        *) fail "unknown stow action: $action"; return ;;
    esac

    if [[ "$profile" == "mac" ]]; then
        # Folder symlinks would send generated themes/state back into dotfiles.
        # Native mutable selectors are seeded below, never Stow-managed on macOS.
        args+=(--no-folding
            '--ignore=(^|/)macarchy-current\.(json|toml|tmTheme|theme)$'
            '--ignore=(^|/)\.pi/agent/(settings\.json|auth\.json|sessions|cache|pi-codex-logs|pi-crash\.log)(/|$)'
            '--ignore=(^|/)\.config/herdr/(config\.toml|release-notes\.json|session.*\.json|.*\.(log|sock)|pre-update-[^/]+)(/|$)'
            '--ignore=(^|/)\.codex/config\.toml$'
            '--ignore=(^|/)\.config/spicetify/(config-xpui\.ini|Themes/text/color\.ini)$'
        )
    fi
    if [[ "$action" == "simulate" ]]; then
        stow "${args[@]}" "${packages[@]}" >/dev/null 2>&1 || fail "$list_name Stow dry-run failed"
    else
        info "$action $list_name -> $target"
        stow "${args[@]}" "${packages[@]}" || fail "$action failed for $list_name"
    fi
}

check_mac_runtime_roots() {
    local path
    for path in .config .config/macarchy .config/macarchy/themes \
        .config/macarchy/generations .config/macarchy/state .config/macarchy/run \
        .config/macarchy/desktop .config/macarchy/environment .config/macarchy/keybindings \
        .config/macarchy/screensaver .config/herdr .config/spicetify \
        .config/spicetify/Themes .config/spicetify/Themes/text \
        .pi .pi/agent .pi/agent/themes .codex .codex/themes; do
        if [[ -L "$HOME/$path" ]]; then
            fail "$HOME/$path is a directory symlink; migrate its ownership before macOS Stow (see mac-config/mac-install/README.md)"
        elif [[ -e "$HOME/$path" && ! -d "$HOME/$path" ]]; then
            fail "$HOME/$path must be a real directory"
        fi
    done
}

seed_native_config() {
    local source="$1"
    local target="$2"
    if [[ -L "$target" ]]; then
        fail "$target is linked; migrate it to an ordinary local file before setup"
    elif [[ -e "$target" ]]; then
        [[ -f "$target" ]] || fail "$target is not a regular config file"
    else
        [[ -f "$source" ]] || { fail "native config seed missing: $source"; return; }
        info "seed local config: $target"
        mkdir -p "$(dirname "$target")" || { fail "cannot create config parent"; return; }
        # noclobber also protects a file created by the app after the check.
        (umask 077; set -C; cat "$source" > "$target") || fail "could not seed $target"
    fi
}

run_profile() {
    local action="$1"
    local profile="$2"

    failures=0

    case "$profile" in
        mac)
            check_mac_runtime_roots
            [[ "$failures" -eq 0 ]] || return 1
            run_stow_action "$action" common "$HOME" mac
            [[ "$failures" -eq 0 ]] || return 1
            run_stow_action "$action" mac "$HOME" mac
            [[ "$failures" -eq 0 ]] || return 1
            seed_native_config "$COMMON_DIR/herdr/.config/herdr/config.toml" "$HOME/.config/herdr/config.toml"
            seed_native_config "$COMMON_DIR/pi/.pi/agent/settings.json" "$HOME/.pi/agent/settings.json"
            seed_native_config "$MAC_DIR/codex/.codex/config.toml" "$HOME/.codex/config.toml"
            ;;
        arch)
            run_stow_action "$action" common "$HOME"
            run_stow_action "$action" arch "$HOME"
            ;;
        arch-system)
            if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
                warn "arch-system targets / and may require sudo"
            fi
            run_stow_action "$action" arch-system /
            ;;
        *)
            usage >&2
            return 2
            ;;
    esac

    [[ "$failures" -eq 0 ]]
}

install_herdr_arch() {
    failures=0

    if command -v herdr >/dev/null 2>&1; then
        pass "herdr already installed: $(herdr --version 2>/dev/null || printf 'version unknown')"
        return 0
    fi

    if command -v paru >/dev/null 2>&1; then
        info "install herdr-bin with paru"
        paru -S --needed herdr-bin || fail "failed to install herdr-bin with paru"
    elif command -v yay >/dev/null 2>&1; then
        info "install herdr-bin with yay"
        yay -S --needed herdr-bin || fail "failed to install herdr-bin with yay"
    elif command -v curl >/dev/null 2>&1; then
        info "install herdr with official installer"
        curl -fsSL https://herdr.dev/install.sh | sh || fail "failed to install herdr with official installer"
    else
        fail "no AUR helper or curl found; install herdr-bin with paru/yay or run: curl -fsSL https://herdr.dev/install.sh | sh"
    fi

    [[ "$failures" -eq 0 ]]
}

check_broken_symlinks() {
    local root
    for root in "$COMMON_DIR" "$MAC_DIR" "$ARCH_DIR"; do
        while IFS= read -r link; do
            local target
            target="$(readlink "$link")"
            local resolved
            if [[ "$target" == /* ]]; then
                resolved="$target"
            else
                resolved="$(dirname "$link")/$target"
            fi

            [[ -e "$resolved" ]] \
                || is_optional_claude_bridge "$link" "$target" \
                || fail "broken symlink: $link -> $target"
        done < <(find "$root" -type l -print)
    done
}

check_shared_claude_skill_bridges() {
    local shared_skills="$COMMON_DIR/agents/.agents/skills"
    local claude_skills
    local skill
    local skill_name
    local bridge
    local target
    local expected_target="../../../../../common-config/common-dotfiles/agents/.agents/skills"
    local pi_visualize_target="../../../../../common-config/common-dotfiles/pi/.pi/agent/extensions/pi-visualize-code-changes/skills/visualize-code-changes"

    for claude_skills in \
        "$MAC_DIR/claude/.claude/skills" \
        "$ARCH_DIR/claude/.claude/skills"
    do
        while IFS= read -r skill; do
            skill_name="$(basename "$skill")"
            bridge="$claude_skills/$skill_name"

            if [[ ! -L "$bridge" ]]; then
                if [[ -e "$bridge" ]]; then
                    fail "shared Claude skill must be a symlink: ${bridge#"$REPO_ROOT/"}"
                else
                    fail "missing shared Claude skill bridge: ${bridge#"$REPO_ROOT/"}"
                fi
                continue
            fi

            target="$(readlink "$bridge")"
            if [[ "$target" != "$expected_target/$skill_name" ]]; then
                fail "incorrect shared Claude skill bridge: ${bridge#"$REPO_ROOT/"} -> $target"
            fi
        done < <(find "$shared_skills" -mindepth 1 -maxdepth 1 -type d -print)

        bridge="$claude_skills/visualize-code-changes"
        if [[ ! -L "$bridge" ]]; then
            fail "missing Pi-to-Claude skill bridge: ${bridge#"$REPO_ROOT/"}"
        else
            target="$(readlink "$bridge")"
            if [[ "$target" != "$pi_visualize_target" ]]; then
                fail "incorrect Pi-to-Claude skill bridge: ${bridge#"$REPO_ROOT/"} -> $target"
            fi
        fi
    done
}

is_optional_claude_bridge() {
    local link="$1"
    local target="$2"

    case "$link:$target" in
        */codex/.codex/prompts/agent-*.md:*/claude/.claude/agents/*.md) return 0 ;;
        */codex/.codex/skills/*:*/claude/.claude/skills/*) return 0 ;;
        *) return 1 ;;
    esac
}

check_shell_syntax() {
    local file
    for file in \
        "$REPO_ROOT/mac-config/mac-install/install.sh" \
        "$REPO_ROOT/mac-config/mac-install/set-defaults.sh" \
        "$REPO_ROOT/scripts/dotfiles"
    do
        [[ -f "$file" ]] || continue
        bash -n "$file" || fail "shell syntax failed: $file"
    done

    while IFS= read -r file; do
        bash -n "$file" || fail "shell syntax failed: $file"
    done < <(find "$REPO_ROOT/arch-config/arch-dotfiles/scripts" -type f -name '*.sh' -print)
}

check_json() {
    if ! command -v jq >/dev/null 2>&1; then
        warn "jq is not available; skipping JSON validation"
        return
    fi

    local file
    while IFS= read -r file; do
        jq empty "$file" >/dev/null || fail "JSON validation failed: $file"
    done < <(find "$COMMON_DIR" "$MAC_DIR" "$ARCH_DIR" -path '*/node_modules/*' -prune -o -type f -name '*.json' -print)
}

doctor() {
    info "Checking package lists"
    check_package_list common
    check_package_list mac
    check_package_list arch
    check_package_list arch-system

    info "Running clean-target Stow dry-runs"
    local target
    target="$(mktemp -d)"
    run_stow_dry_run common "$target"
    run_stow_dry_run common "$target" mac
    run_stow_dry_run mac "$target" mac
    run_stow_dry_run arch "$target"
    run_stow_dry_run arch-system "$target"
    rm -rf "$target"

    info "Checking symlinks"
    check_broken_symlinks
    check_shared_claude_skill_bridges

    info "Checking shell syntax"
    check_shell_syntax

    info "Checking JSON"
    check_json

    if [[ "$failures" -eq 0 ]]; then
        pass "doctor completed"
        return 0
    fi

    printf 'Doctor found %s issue(s).\n' "$failures" >&2
    return 1
}

case "${1:-}" in
    doctor)
        doctor
        ;;
    install-herdr)
        if [[ $# -ne 2 || "$2" != "arch" ]]; then
            usage >&2
            exit 2
        fi
        install_herdr_arch
        ;;
    stow|restow)
        if [[ $# -ne 2 ]]; then
            usage >&2
            exit 2
        fi
        run_profile "$1" "$2"
        ;;
    -h|--help|help|'')
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
