#!/usr/bin/env bash
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

COMMON_DIR="$REPO_ROOT/common-config/common-dotfiles"
MAC_DIR="$REPO_ROOT/mac-config/mac-dotfiles"
ARCH_DIR="$REPO_ROOT/arch-config/arch-dotfiles"
PACKAGE_DIR="$REPO_ROOT/packages"

failures=0

info() {
    printf '==> %s\n' "$1"
}

pass() {
    printf 'OK: %s\n' "$1"
}

fail() {
    printf 'FAIL: %s\n' "$1" >&2
    failures=$((failures + 1))
}

warn() {
    printf 'WARN: %s\n' "$1" >&2
}

usage() {
    cat <<'EOF'
Usage: scripts/dotfiles <command> [profile]

Commands:
  doctor              Validate package lists, Stow dry-runs, symlinks, shell, and JSON
  stow mac            Stow common and macOS user packages into $HOME
  stow arch           Stow common and Arch user packages into $HOME
  stow arch-system    Stow Arch system packages into /
  restow mac          Restow common and macOS user packages into $HOME
  restow arch         Restow common and Arch user packages into $HOME
  restow arch-system  Restow Arch system packages into /
EOF
}

package_root() {
    case "$1" in
        common) printf '%s\n' "$COMMON_DIR" ;;
        mac) printf '%s\n' "$MAC_DIR" ;;
        arch|arch-system) printf '%s\n' "$ARCH_DIR" ;;
        *) return 1 ;;
    esac
}

package_list() {
    printf '%s/%s.txt\n' "$PACKAGE_DIR" "$1"
}

package_names() {
    while IFS= read -r package || [[ -n "$package" ]]; do
        [[ -z "$package" || "$package" == \#* ]] && continue
        printf '%s\n' "$package"
    done < "$(package_list "$1")"
}

check_package_list() {
    local list_name="$1"
    local root
    root="$(package_root "$list_name")"
    local list_file
    list_file="$(package_list "$list_name")"

    if [[ ! -d "$root" ]]; then
        fail "$list_name root missing: $root"
        return
    fi

    if [[ ! -f "$list_file" ]]; then
        fail "$list_name package list missing: $list_file"
        return
    fi

    local package
    while IFS= read -r package; do
        [[ -d "$root/$package" ]] || fail "$list_name lists missing package: $package"
    done < <(package_names "$list_name")

    local listed
    local present
    listed="$(mktemp)"
    present="$(mktemp)"

    package_names "$list_name" | sort > "$listed"
    if [[ "$list_name" == "arch" ]]; then
        find "$root" -maxdepth 1 -mindepth 1 -type d ! -name tlp -exec basename {} \; | sort > "$present"
    elif [[ "$list_name" == "arch-system" ]]; then
        printf 'tlp\n' > "$present"
    else
        find "$root" -maxdepth 1 -mindepth 1 -type d -exec basename {} \; | sort > "$present"
    fi

    local unlisted
    unlisted="$(comm -23 "$present" "$listed")"
    if [[ -n "$unlisted" ]]; then
        fail "$list_name has unlisted package directories: $(printf '%s' "$unlisted" | paste -sd ', ' -)"
    fi

    rm -f "$listed" "$present"
}

run_stow_dry_run() {
    local list_name="$1"
    local target="$2"
    local root
    root="$(package_root "$list_name")"

    if ! command -v stow >/dev/null 2>&1; then
        fail "stow command is not available"
        return
    fi

    local packages
    packages="$(package_names "$list_name" | tr '\n' ' ')"
    if [[ -z "$packages" ]]; then
        fail "$list_name package list is empty"
        return
    fi

    if ! stow -n -d "$root" -t "$target" $packages >/dev/null 2>&1; then
        fail "$list_name Stow dry-run failed"
    fi
}

run_stow_action() {
    local action="$1"
    local list_name="$2"
    local target="$3"
    local root
    root="$(package_root "$list_name")"

    if ! command -v stow >/dev/null 2>&1; then
        fail "stow command is not available"
        return
    fi

    local packages
    packages="$(package_names "$list_name" | tr '\n' ' ')"
    if [[ -z "$packages" ]]; then
        fail "$list_name package list is empty"
        return
    fi

    case "$action" in
        stow) ;;
        restow) ;;
        *) fail "unknown stow action: $action"; return ;;
    esac

    info "$action $list_name -> $target"
    if [[ "$action" == "restow" ]]; then
        stow -R -d "$root" -t "$target" $packages || fail "$action failed for $list_name"
    else
        stow -d "$root" -t "$target" $packages || fail "$action failed for $list_name"
    fi
}

run_profile() {
    local action="$1"
    local profile="$2"

    failures=0

    case "$profile" in
        mac)
            run_stow_action "$action" common "$HOME"
            run_stow_action "$action" mac "$HOME"
            ;;
        arch)
            run_stow_action "$action" common "$HOME"
            run_stow_action "$action" arch "$HOME"
            ;;
        arch-system)
            if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
                warn "arch-system targets / and may require sudo"
            fi
            run_stow_action "$action" arch-system /
            ;;
        *)
            usage >&2
            return 2
            ;;
    esac

    [[ "$failures" -eq 0 ]]
}

check_broken_symlinks() {
    local root
    for root in "$COMMON_DIR" "$MAC_DIR" "$ARCH_DIR"; do
        while IFS= read -r link; do
            local target
            target="$(readlink "$link")"
            local resolved
            if [[ "$target" == /* ]]; then
                resolved="$target"
            else
                resolved="$(dirname "$link")/$target"
            fi

            [[ -e "$resolved" ]] \
                || is_optional_claude_bridge "$link" "$target" \
                || fail "broken symlink: $link -> $target"
        done < <(find "$root" -type l -print)
    done
}

is_optional_claude_bridge() {
    local link="$1"
    local target="$2"

    case "$link:$target" in
        */codex/.codex/prompts/agent-*.md:*/claude/.claude/agents/*.md) return 0 ;;
        */codex/.codex/skills/*:*/claude/.claude/skills/*) return 0 ;;
        *) return 1 ;;
    esac
}

check_shell_syntax() {
    local file
    for file in \
        "$REPO_ROOT/mac-config/mac-install/install.sh" \
        "$REPO_ROOT/mac-config/mac-install/set-defaults.sh" \
        "$REPO_ROOT/scripts/dotfiles"
    do
        [[ -f "$file" ]] || continue
        bash -n "$file" || fail "shell syntax failed: $file"
    done

    while IFS= read -r file; do
        bash -n "$file" || fail "shell syntax failed: $file"
    done < <(find "$REPO_ROOT/arch-config/arch-dotfiles/scripts" -type f -name '*.sh' -print)
}

check_json() {
    if ! command -v jq >/dev/null 2>&1; then
        warn "jq is not available; skipping JSON validation"
        return
    fi

    local file
    while IFS= read -r file; do
        jq empty "$file" >/dev/null || fail "JSON validation failed: $file"
    done < <(find "$COMMON_DIR" "$MAC_DIR" "$ARCH_DIR" -path '*/node_modules/*' -prune -o -type f -name '*.json' -print)
}

doctor() {
    info "Checking package lists"
    check_package_list common
    check_package_list mac
    check_package_list arch
    check_package_list arch-system

    info "Running clean-target Stow dry-runs"
    local target
    target="$(mktemp -d)"
    run_stow_dry_run common "$target"
    run_stow_dry_run mac "$target"
    run_stow_dry_run arch "$target"
    run_stow_dry_run arch-system "$target"
    rm -rf "$target"

    info "Checking symlinks"
    check_broken_symlinks

    info "Checking shell syntax"
    check_shell_syntax

    info "Checking JSON"
    check_json

    if [[ "$failures" -eq 0 ]]; then
        pass "doctor completed"
        return 0
    fi

    printf 'Doctor found %s issue(s).\n' "$failures" >&2
    return 1
}

case "${1:-}" in
    doctor)
        doctor
        ;;
    stow|restow)
        if [[ $# -ne 2 ]]; then
            usage >&2
            exit 2
        fi
        run_profile "$1" "$2"
        ;;
    -h|--help|help|'')
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
