#!/bin/bash

# Runs after `omarchy font set` with the font name in $1.

font_name=${1:-$(omarchy-font-current)}

# herdr-app: terminals and panels use the Omarchy monospace font. herdr-app
# reloads settings.json live; other settings in it are kept.
herdr_app_settings="$HOME/.config/herdr-app/settings.json"
if [[ -d $(dirname "$herdr_app_settings") ]]; then
  current=$(cat "$herdr_app_settings" 2>/dev/null || echo '{}')
  tmp_herdr_app=$(mktemp "$herdr_app_settings.XXXXXX")
  if jq --arg font "$font_name" '.font = $font | .ui_font = $font' <<<"$current" >"$tmp_herdr_app"; then
    chmod 644 "$tmp_herdr_app"
    mv "$tmp_herdr_app" "$herdr_app_settings"
  else
    rm -f "$tmp_herdr_app"
    omarchy-notification-send -u normal "herdr-app font not updated" \
      "Could not update $herdr_app_settings" >/dev/null 2>&1
  fi
fi
