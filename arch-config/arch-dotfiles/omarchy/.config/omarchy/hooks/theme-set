#!/bin/bash

colors_file="$HOME/.local/state/omarchy/current/theme/colors.toml"
kitty_theme_file="$HOME/.config/kitty/omarchy-tabbar.conf"
tmux_theme_file="$HOME/.config/tmux/theme.conf"
starship_config="$HOME/.config/starship.toml"
yazi_flavor_dir="$HOME/.config/yazi/flavors/omarchy.yazi"
yazi_theme_file="$HOME/.config/yazi/theme.toml"

[[ -f $colors_file ]] || exit 0

# The theme's colors as Omarchy resolves them. A theme names them the new way
# (red, muted, selection) or the old (color1, color8, selection_background) and
# omarchy-theme-color answers to both; reading colors.toml by hand found only
# the old names, so every newer theme got the fallbacks below instead.
declare -A theme_colors
while IFS=$'\t' read -r key value; do
  theme_colors[$key]=$value
done < <(omarchy-theme-color --file "$colors_file" --all)

if (( ${#theme_colors[@]} == 0 )); then
  omarchy-notification-send -u normal "Theme hook: no colors" \
    "omarchy-theme-color read nothing from $colors_file" >/dev/null 2>&1
  exit 1
fi

color() {
  printf '%s' "${theme_colors[$1]:-$2}"
}

background=$(color background "#11111b")
foreground=$(color foreground "#cdd6f4")
accent=$(color accent "$(color color4 "#89b4fa")")
muted=$(color color8 "#585b70")
surface=$(color selection_background "$(color color0 "$background")")
red=$(color color1 "#f38ba8")
green=$(color color2 "#a6e3a1")
yellow=$(color color3 "#f9e2af")
blue=$(color color4 "#89b4fa")
purple=$(color color5 "$accent")
cyan=$(color color6 "#94e2d5")
white=$(color color7 "$foreground")
bright_red=$(color color9 "$red")
bright_green=$(color color10 "$green")
bright_yellow=$(color color11 "$yellow")
bright_blue=$(color color12 "$blue")
bright_purple=$(color color13 "$purple")
bright_cyan=$(color color14 "$cyan")
bright_white=$(color color15 "$foreground")

mkdir -p "$(dirname "$kitty_theme_file")" "$(dirname "$tmux_theme_file")" "$yazi_flavor_dir"

cat >"$kitty_theme_file" <<KITTY
# Generated by ~/.config/omarchy/hooks/theme-set
# Do not edit directly; change the hook or active Omarchy theme colors.
tab_bar_background          $background
active_tab_foreground       $background
active_tab_background       $accent
inactive_tab_foreground     $muted
inactive_tab_background     $surface
KITTY

cat >"$tmux_theme_file" <<TMUX
# Generated by ~/.config/omarchy/hooks/theme-set
# Do not edit directly; change the hook or active Omarchy theme colors.
set -g status-style "bg=$background,fg=$foreground"
set -g status-left "#[fg=$background,bg=$accent,bold] #S #[fg=$muted,bg=$background,nobold] "
set -g status-right "#[fg=$accent,bg=$background]#{?pane_in_mode,COPY ,}#{?client_prefix,PREFIX ,}#{?window_zoomed_flag,ZOOM ,}#[fg=$muted,bg=$background]#h "
set -g window-status-format "#[fg=$muted,bg=$background] #I:#W "
set -g window-status-current-format "#[fg=$accent,bg=$background,bold] #I:#W "
set -g pane-border-style "fg=$muted"
set -g pane-active-border-style "fg=$accent"
set -g message-style "bg=$background,fg=$accent"
set -g message-command-style "bg=$background,fg=$accent"
set -g mode-style "bg=$accent,fg=$background"
setw -g clock-mode-colour "$accent"

# tmux-dotbar compatibility for ~/.tmux.conf
set -g @tmux-dotbar-bg "$background"
set -g @tmux-dotbar-fg "$muted"
set -g @tmux-dotbar-fg-current "$foreground"
set -g @tmux-dotbar-fg-session "$muted"
set -g @tmux-dotbar-fg-prefix "$accent"
set -g @tmux-dotbar-position top
TMUX

if [[ -f $starship_config ]]; then
  tmp_starship=$(mktemp)

  if grep -q '^palette[[:space:]]*=' "$starship_config"; then
    sed -E 's/^palette[[:space:]]*=.*/palette = "omarchy"/' "$starship_config" >"$tmp_starship"
  else
    printf 'palette = "omarchy"\n' >"$tmp_starship"
    cat "$starship_config" >>"$tmp_starship"
  fi

  awk '
    /^# BEGIN OMARCHY GENERATED PALETTE$/ { skip = 1; next }
    /^# END OMARCHY GENERATED PALETTE$/ { skip = 0; next }
    skip { next }
    # Blank lines are held until a line follows them, so the ones the removed
    # block leaves at the end go: the block below brings its own, and each
    # run used to add one more.
    /^[[:space:]]*$/ { blanks++; next }
    { for (; blanks > 0; blanks--) print ""; print }
  ' "$tmp_starship" >"$tmp_starship.clean"

  cat >>"$tmp_starship.clean" <<STARSHIP

# BEGIN OMARCHY GENERATED PALETTE
# Generated by ~/.config/omarchy/hooks/theme-set
# Do not edit this block directly; change the hook or active Omarchy theme colors.
[palettes.omarchy]
background = "$background"
foreground = "$foreground"
black = "$background"
red = "$red"
green = "$green"
yellow = "$yellow"
blue = "$blue"
purple = "$purple"
magenta = "$purple"
cyan = "$cyan"
white = "$white"
bright-black = "$muted"
bright-red = "$bright_red"
bright-green = "$bright_green"
bright-yellow = "$bright_yellow"
bright-blue = "$bright_blue"
bright-purple = "$bright_purple"
bright-magenta = "$bright_purple"
bright-cyan = "$bright_cyan"
bright-white = "$bright_white"
# END OMARCHY GENERATED PALETTE
STARSHIP

  cat "$tmp_starship.clean" >"$starship_config"
  rm -f "$tmp_starship" "$tmp_starship.clean"
fi

cat >"$yazi_flavor_dir/flavor.toml" <<YAZI
# Generated by ~/.config/omarchy/hooks/theme-set
# Do not edit directly; change the hook or active Omarchy theme colors.

[mgr]
cwd = { fg = "$cyan" }
hovered = { fg = "$background", bg = "$accent", bold = true }
preview_hovered = { underline = true }
find_keyword = { fg = "$yellow", bold = true, italic = true, underline = true }
find_position = { fg = "$purple", bg = "reset", bold = true, italic = true }
marker_copied = { fg = "$green", bg = "$green" }
marker_cut = { fg = "$red", bg = "$red" }
marker_marked = { fg = "$blue", bg = "$blue" }
marker_selected = { fg = "$yellow", bg = "$yellow" }
count_copied = { fg = "$background", bg = "$green" }
count_cut = { fg = "$background", bg = "$red" }
count_selected = { fg = "$background", bg = "$yellow" }
border_symbol = "│"
border_style = { fg = "$muted" }

[tabs]
active = { fg = "$background", bg = "$accent", bold = true }
inactive = { fg = "$muted", bg = "$surface" }

[mode]
normal_main = { fg = "$background", bg = "$accent", bold = true }
normal_alt = { fg = "$accent", bg = "$surface" }
select_main = { fg = "$background", bg = "$green", bold = true }
select_alt = { fg = "$green", bg = "$surface" }
unset_main = { fg = "$background", bg = "$purple", bold = true }
unset_alt = { fg = "$purple", bg = "$surface" }

[status]
perm_sep = { fg = "$muted" }
perm_type = { fg = "$blue" }
perm_read = { fg = "$yellow" }
perm_write = { fg = "$red" }
perm_exec = { fg = "$green" }
progress_label = { fg = "$foreground", bold = true }
progress_normal = { fg = "$accent", bg = "$surface" }
progress_error = { fg = "$red", bg = "$surface" }

[pick]
border = { fg = "$accent" }
active = { fg = "$purple", bold = true }
inactive = {}

[input]
border = { fg = "$accent" }
title = {}
value = {}
selected = { reversed = true }

[cmp]
border = { fg = "$accent" }

[tasks]
border = { fg = "$accent" }
title = {}
hovered = { fg = "$purple", underline = true }

[which]
mask = { bg = "$surface" }
cand = { fg = "$cyan" }
rest = { fg = "$muted" }
desc = { fg = "$purple" }
separator = "  "
separator_style = { fg = "$muted" }

[help]
on = { fg = "$cyan" }
run = { fg = "$purple" }
hovered = { reversed = true, bold = true }
footer = { fg = "$background", bg = "$foreground" }

[notify]
title_info = { fg = "$green" }
title_warn = { fg = "$yellow" }
title_error = { fg = "$red" }

[filetype]
rules = [
  { mime = "image/*", fg = "$cyan" },
  { mime = "{audio,video}/*", fg = "$yellow" },
  { mime = "application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "$purple" },
  { mime = "application/{pdf,doc,rtf}", fg = "$green" },
  { url = "*/", fg = "$accent" },
  { url = "*", fg = "$foreground" },
]
YAZI

if [[ -d $(dirname "$yazi_theme_file") ]]; then
  cat >"$yazi_theme_file" <<YAZI_THEME
# Generated by ~/.config/omarchy/hooks/theme-set
# Do not edit directly; change the hook or active Omarchy theme colors.
[flavor]
dark = "omarchy"
YAZI_THEME
fi

# herdr-app: Omarchy renders ~/.config/omarchy/themed/herdr-app.json.tpl into the
# theme; install it where herdr-app reads themes. herdr-app reloads it live.
herdr_app_theme_src="$HOME/.local/state/omarchy/current/theme/herdr-app.json"
herdr_app_theme_file="${HERDR_APP_HOME:-$HOME/.config/herdr-app}/themes/omarchy.json"
if [[ -d $(dirname "$herdr_app_theme_file") ]]; then
  if [[ ! -f $herdr_app_theme_src ]] || grep -q '{{' "$herdr_app_theme_src"; then
    omarchy-notification-send -u normal "herdr-app theme not updated" \
      "$herdr_app_theme_src is missing or has unrendered colors" >/dev/null 2>&1
  else
    tmp_herdr_app=$(mktemp "$herdr_app_theme_file.XXXXXX")
    cp "$herdr_app_theme_src" "$tmp_herdr_app"
    chmod 644 "$tmp_herdr_app"
    mv "$tmp_herdr_app" "$herdr_app_theme_file"

    # Select it; other settings in settings.json are kept.
    herdr_app_settings="${HERDR_APP_HOME:-$HOME/.config/herdr-app}/settings.json"
    current=$(cat "$herdr_app_settings" 2>/dev/null || echo '{}')
    if [[ $(jq -r '.theme // empty' <<<"$current") != omarchy ]]; then
      tmp_herdr_app=$(mktemp "$herdr_app_settings.XXXXXX")
      if jq '.theme = "omarchy"' <<<"$current" >"$tmp_herdr_app"; then
        chmod 644 "$tmp_herdr_app"
        mv "$tmp_herdr_app" "$herdr_app_settings"
      else
        rm -f "$tmp_herdr_app"
        omarchy-notification-send -u normal "herdr-app theme not selected" \
          "Could not update $herdr_app_settings" >/dev/null 2>&1
      fi
    fi
  fi
fi

if pgrep -x tmux >/dev/null; then
  tmux source-file "$tmux_theme_file" >/dev/null 2>&1 || true
fi

if pgrep -x kitty >/dev/null; then
  killall -SIGUSR1 kitty >/dev/null 2>&1 || true
fi
