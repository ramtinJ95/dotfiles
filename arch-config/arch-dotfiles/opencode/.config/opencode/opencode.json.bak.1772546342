{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@howaboua/opencode-workflows-tool@latest"
  ],
  "provider": {
    "github-copilot": {
      "models": {
        "gpt-5.3-codex": {}
      }
    }
  },
  "model": "github-copilot/gpt-5.2-codex",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    },
    "dbt": {
      "type": "local",
      "command": [
        "uvx",
        "dbt-mcp"
      ],
      "environment": {
        "DBT_PROJECT_DIR": "/home/ramtinj/workspace/analytics-platform/dbt_project",
        "DBT_PATH": "/home/ramtinj/workspace/analytics-platform/dbt_project/.venv/bin/dbt",
        "DBT_PROFILES_DIR": "/home/ramtinj/workspace/analytics-platform/dbt_project/profiles"
      }
    }
  },
  "permission": {
    "bash": {
      "rm *": "ask"
    },
    "skill": {
      "egenskriven*": "deny",
      "adding-dbt-unit-test": "deny",
      "answering-natural-language-questions-with-dbt": "deny",
      "building-dbt-semantic-layer": "deny",
      "configuring-dbt-mcp-server": "deny",
      "fetching-dbt-docs": "deny",
      "migrating-dbt-core-to-fusion": "deny",
      "troubleshooting-dbt-job-errors": "deny",
      "using-dbt-for-analytics-engineering": "deny"
    }
  },
  "tools": {
    "context7*": false,
    "gh_grep*": false,
    "playwright*": false,
    "dbt*": false
  },
  "keybinds": {
    "leader": "ctrl+e",
    "session_list": "none",
    "messages_toggle_conceal": "none",
    "messages_first": "ctrl+shift+g,home",
    "session_child_cycle": "leader+h",
    "session_child_cycle_reverse": "leader+l"
  },
  "experimental": {
    "batch_tool": true
  }
}
