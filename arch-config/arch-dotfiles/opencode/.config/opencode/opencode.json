{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    }
  },
  "tools": {
    "context7*": false,
    "gh_grep": false
  },
  "provider": {
    "openrouter": {
      "models": {
        "minimax/minimax-m2:free": {}
      }
    }
  }
}
