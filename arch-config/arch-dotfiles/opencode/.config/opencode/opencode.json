{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.2-codex",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--browser",
        "chromium"
      ]
    },
    "dbt": {
      "type": "local",
      "command": [
        "uvx",
        "dbt-mcp"
      ],
      "environment": {
        "DBT_PROJECT_DIR": "/home/ramtinj/workspace/analytics-platform/dbt_project",
        "DBT_PATH": "/home/ramtinj/workspace/analytics-platform/dbt_project/.venv/bin/dbt",
        "DBT_PROFILES_DIR": "/home/ramtinj/workspace/analytics-platform/dbt_project/profiles"
      }
    }
  },
  "permission": {
    "bash": {
      "rm *": "ask"
    }
  },
  "tools": {
    "context7*": false,
    "gh_grep*": false,
    "playwright*": false,
    "dbt*": false
  },
  "provider": {
    "anthropic": {
      "models": {
        "claude-opus-4-5-20251101": {
          "id": "claude-opus-4-5-20251101",
          "name": "Opus 4.5 Thinking",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 32000,
            },
          },
        },
      },
    },
  },
  "keybinds": {
    "leader": "ctrl+e",
    "session_list": "none",
    "messages_toggle_conceal": "none",
    "session_child_cycle": "leader+h",
    "session_child_cycle_reverse": "leader+l"
  },
  "experimental": {
    "batch_tool": true
  },
}
