{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "ScheduleWakeup",
      "ShareOnboardingGuide"
    ]
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "context7.com",
        "*.context7.com"
      ]
    }
  },
  "disableClaudeAiConnectors": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "includeGitInstructions": false,
  "skillOverrides": {
    "claude-api": "user-invocable-only",
    "update-config": "user-invocable-only",
    "claude-in-chrome": "off",
    "dataviz": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "loop": "off",
    "schedule": "off",
    "run": "user-invocable-only",
    "simplify": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/guard_infra_commands.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/ramtin/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "effortLevel": "high",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "switchModelsOnFlag": false
}
