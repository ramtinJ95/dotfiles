# default layout (can be bsp, stack or float)
yabai -m config layout bsp

# new window spawns to the right if vertical split, or bottom if horizontal split
yabai -m config window_placement second_child
yabai -m config window_insertion_point first
yabai -m config auto_balance off
yabai -m config split_ratio 0.30

# padding around managed windows
yabai -m config top_padding 0
yabai -m config bottom_padding 5
yabai -m config left_padding 5
yabai -m config right_padding 5
yabai -m config window_gap 5

# -- mouse settings --

# center mouse on window with focus
yabai -m config mouse_follows_focus on

# modifier for clicking and dragging with mouse
yabai -m config mouse_modifier alt
# set modifier + left-click drag to move window
yabai -m config mouse_action1 move
# set modifier + right-click drag to resize window
yabai -m config mouse_action2 resize

# disable specific apps
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add title="^SFML$" manage=off
yabai -m rule --add title="Our Love Story$" manage=off
yabai -m rule --add title="^Software Renderer$" manage=off

# Reserve room for sketchybar plus a small gap (sketchybar height is 30).
yabai -m config external_bar all:35:0

# NSWorkspace cannot target inactive Spaces; reconcile each one when it becomes active.
yabai -m signal --add event=space_changed label=macarchy-wallpaper action="/Users/ramtin/.local/bin/macarchy reconcile wallpaper"
