# Portable assets only. Mutable JSON seeds are copied by scripts/dotfiles.
# Never link caches, credentials, trust decisions, model caches or Mac local LLMs.
(\.git|node_modules|\.claude)
(\.gitignore|\.DS_Store|\.stow-local-ignore)
^/\.pi/(?!agent(?:/|$)).+
^/\.pi/agent/(?!AGENTS\.md$|REALTIME-SYSTEM-PROMPT\.md$|ask\.json$|claude-delegation\.json$|infra-command-guard\.json$|keybindings\.json$|pi-gpt-switcher\.json$|extensions(?:/|$)|codex-conversion-custom-tools(?:/|$)|prompts(?:/|$)|shepherdr(?:/|$)).+
^/\.pi/agent/shepherdr/(?!profiles(?:/|$)).+
# The adapter ignores symlink TOMLs. Seed/sync these as real files instead.
^/\.pi/agent/codex-conversion-custom-tools/[^/]+\.toml$
# Never reinstall the retired TUI adapters, even in a dirty checkout.
^/\.pi/agent/codex-conversion-custom-tools/(herdr-agent|spawn-agent)(/|$)
^/\.pi/agent/extensions/herdr-agent-state\.ts$
.*\.(log|sqlite|bak)$
