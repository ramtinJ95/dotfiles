#!/usr/bin/env bash
set -euo pipefail
SESSION="${SESSION:-qwen36-35b-a3b-mtp-llama}"
LOG="$HOME/.pi/agent/local-llm/logs/${SESSION}.log"
START="$HOME/.pi/agent/local-llm/bin/start-qwen36-35b-a3b-mtp-llama"
if tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "tmux session '$SESSION' already running"
  echo "Attach: tmux attach -t $SESSION"
  echo "Logs:   tail -f $LOG"
  exit 0
fi
mkdir -p "$(dirname "$LOG")"
: > "$LOG"
tmux new-session -d -s "$SESSION" "exec '$START' 2>&1 | tee -a '$LOG'"
echo "Started qwen36-35b-a3b-mtp in tmux session '$SESSION'"
echo "Attach: tmux attach -t $SESSION"
echo "Logs:   tail -f $LOG"
